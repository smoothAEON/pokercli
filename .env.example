# Default location: <repo>/.env
# Override at runtime with POKER_ENV_PATH=/path/to/custom.env
# Seat 1 is always the human player.
# LLM simulation entries can reference these blocks with {"type":"llm","env_seat":N}.

# -- Global table settings --
POKER_SEATS=5
POKER_HUMAN_SEAT=1
POKER_STACK_BB=100
POKER_MAX_HANDS=25

# -- Seat 2: OpenAI --
POKER_SEAT_2_TYPE=llm
POKER_SEAT_2_NAME=gpt-4o
POKER_SEAT_2_PROVIDER=openai
POKER_SEAT_2_MODEL=gpt-4o
POKER_SEAT_2_API_KEY=replace_me
POKER_SEAT_2_TIMEOUT_S=30
POKER_SEAT_2_TEMPERATURE=0
POKER_SEAT_2_BASE_URL=https://api.openai.com/v1

# -- Seat 3: Anthropic --
POKER_SEAT_3_TYPE=llm
POKER_SEAT_3_NAME=claude-sonnet-4-5
POKER_SEAT_3_PROVIDER=anthropic
POKER_SEAT_3_MODEL=claude-sonnet-4-5
POKER_SEAT_3_API_KEY=replace_me
POKER_SEAT_3_TIMEOUT_S=30
POKER_SEAT_3_TEMPERATURE=0
POKER_SEAT_3_BASE_URL=https://api.anthropic.com

# -- Seat 4: NVIDIA NIM (free tier available) --
POKER_SEAT_4_TYPE=llm
POKER_SEAT_4_NAME=nvidia/llama-3.1-nemotron-nano-8b-v1
POKER_SEAT_4_PROVIDER=nvidia
POKER_SEAT_4_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
POKER_SEAT_4_API_KEY=replace_me
POKER_SEAT_4_TIMEOUT_S=30
POKER_SEAT_4_TEMPERATURE=0
POKER_SEAT_4_BASE_URL=https://integrate.api.nvidia.com/v1

# -- Seat 5: OpenRouter (multi-model gateway) --
POKER_SEAT_5_TYPE=llm
POKER_SEAT_5_NAME=openai/gpt-4o
POKER_SEAT_5_PROVIDER=openrouter
POKER_SEAT_5_MODEL=openai/gpt-4o
POKER_SEAT_5_API_KEY=replace_me
POKER_SEAT_5_TIMEOUT_S=30
POKER_SEAT_5_TEMPERATURE=0
POKER_SEAT_5_BASE_URL=https://openrouter.ai/api/v1
