# Default location: <repo>/.env
# Override at runtime with POKER_ENV_PATH=/path/to/custom.env
# Seat 1 is always the human player.
# LLM simulation entries can reference these blocks with {"type":"llm","env_seat":N}.
POKER_SEATS=3
POKER_HUMAN_SEAT=1
POKER_STACK_BB=100
POKER_MAX_HANDS=25

POKER_SEAT_2_TYPE=llm
POKER_SEAT_2_NAME=Bot 2
POKER_SEAT_2_PROVIDER=openrouter
POKER_SEAT_2_MODEL=openai/gpt-4o
POKER_SEAT_2_API_KEY=replace_me
POKER_SEAT_2_TIMEOUT_S=30
POKER_SEAT_2_TEMPERATURE=0

POKER_SEAT_3_TYPE=llm
POKER_SEAT_3_NAME=Bot 3
POKER_SEAT_3_PROVIDER=nvidia
POKER_SEAT_3_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
POKER_SEAT_3_API_KEY=replace_me
POKER_SEAT_3_TIMEOUT_S=30
POKER_SEAT_3_TEMPERATURE=0
